# Cloudflare R2 (S3-compatible)
# Web needs read; uploader (push-build) needs write on the same credentials.
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET="dev-builds"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Auth.js v5 + Mobile JWT signing secret (generate via: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth Web Client credentials
# Authorized redirect URIs:
#   https://geekom-a7.ide-cherimoya.ts.net:3015/api/auth/callback/google
#   http://localhost:3015/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Single authorized Google account email address
ALLOWED_EMAIL=""

# Local Tailscale HTTPS (certs in ~/localhost/_certs/)
USE_LOCAL_HTTPS=true
TAILSCALE_HOST=geekom-a7.ide-cherimoya.ts.net
PORT=3015
AUTH_URL="https://geekom-a7.ide-cherimoya.ts.net:3015"
AUTH_TRUST_HOST=true
