{
    "name": "mercury",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "pnpm --filter mercury-web dev",
        "build": "pnpm --filter mercury-web build",
        "start": "pnpm --filter mercury-web start",
        "check": "pnpm -r --if-present check",
        "lint": "pnpm -r --if-present lint",
        "lint:fix": "pnpm -r --if-present lint:fix",
        "validate": "pnpm -r --if-present validate",
        "push-build": "./apps/uploader/bin/push-build"
    }
}
