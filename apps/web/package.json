{
    "name": "mercury-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "build": "tsx scripts/with-env.ts next build",
        "start": "tsx scripts/with-env.ts next start --hostname 0.0.0.0 --port 3015",
        "check": "tsc --noEmit",
        "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
        "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
        "validate": "pnpm check && pnpm lint"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1175.0",
        "@aws-sdk/s3-request-presigner": "^3.1175.0",
        "@base-ui/react": "^1.9.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jose": "^6.2.18",
        "lucide-react": "^1.77.0",
        "next": "^16.4.6",
        "next-auth": "5.0.0-beta.32",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.4.6",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.15.0",
        "eslint-plugin-indent-empty-lines": "^2.0.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
